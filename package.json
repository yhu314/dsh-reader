{
  "name": "dsh_reader",
  "version": "0.1.0",
  "description": "Continuous markdown book reader with inline annotations for the DeepSeek Harness Web GUI: opens .md files as one scrollable book in the right Sidebar.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "markdown",
    "reader",
    "annotation",
    "sidebar"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhu314/dsh-reader.git"
  },
  "homepage": "https://github.com/yhu314/dsh-reader",
  "bugs": {
    "url": "https://github.com/yhu314/dsh-reader/issues"
  }
}
